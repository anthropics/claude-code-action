# Anthropic Claude Code Action - Environment Variables Example
# Copy this file to .env.local and fill in your values
# Note: Never commit actual API keys or secrets to version control

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Anthropic API Key (required for direct API access)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude Code OAuth Token (alternative to API key)
# For Claude Code CLI authentication
CLAUDE_CODE_OAUTH_TOKEN=

# Workload Identity Federation (alternative to API key)
# Use with ANTHROPIC_ORGANIZATION_ID for federated authentication
ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
ANTHROPIC_OIDC_AUDIENCE=https://api.anthropic.com

# ============================================================================
# ORGANIZATION & WORKSPACE
# ============================================================================

# Anthropic Organization ID (UUID)
ANTHROPIC_ORGANIZATION_ID=

# Service Account ID (for service-to-service auth)
ANTHROPIC_SERVICE_ACCOUNT_ID=

# Workspace ID (for workspace-specific operations)
ANTHROPIC_WORKSPACE_ID=

# ============================================================================
# CUSTOM API ENDPOINTS (Internal/Development)
# ============================================================================

# Custom Anthropic API base URL (for internal endpoints)
# Default: https://api.anthropic.com
ANTHROPIC_BASE_URL=

# Custom headers for API requests (JSON format)
ANTHROPIC_CUSTOM_HEADERS=

# ============================================================================
# CLOUD PROVIDER CONFIGURATION
# ============================================================================

# AWS Bedrock
# Set to '1' to use AWS Bedrock as provider
CLAUDE_CODE_USE_BEDROCK=
ANTHROPIC_BEDROCK_BASE_URL=
AWS_REGION=us-east-1

# Google Vertex AI
# Set to '1' to use Google Vertex as provider
CLAUDE_CODE_USE_VERTEX=
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_BASE_URL=
VERTEX_REGION_CLAUDE_3_5_HAIKU=
VERTEX_REGION_CLAUDE_3_5_SONNET=
VERTEX_REGION_CLAUDE_3_7_SONNET=

# Anthropic Foundry
# Set to '1' to use Anthropic Foundry as provider
CLAUDE_CODE_USE_FOUNDRY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_BASE_URL=

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Default model to use (overrides claude-opus-5)
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5-20251001

# ============================================================================
# CLAUDE CODE BEHAVIOR
# ============================================================================

# Additional Claude arguments (space-separated)
# Example: --model claude-opus-5 --max-turns 10
CLAUDE_ARGS=

# Path to custom Claude Code executable
PATH_TO_CLAUDE_CODE_EXECUTABLE=

# Disable environment variable scrubbing in subprocesses (dev only)
# Set to '0' to keep all env vars in subprocess, '1' to scrub (default)
CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=

# Script capability configuration (JSON)
CLAUDE_CODE_SCRIPT_CAPS=

# ============================================================================
# GITHUB CONFIGURATION
# ============================================================================

# GitHub API token (if not using GitHub App token)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub server URL (for GitHub Enterprise Server)
GITHUB_SERVER_URL=https://github.com

# GitHub API URL (for GitHub Enterprise Server)
GITHUB_API_URL=https://api.github.com

# ============================================================================
# DEVELOPMENT/DEBUGGING
# ============================================================================

# Node environment
NODE_ENV=development

# Enable verbose logging
DEBUG=*

# MCP configuration (Model Context Protocol)
MCP_TOOL_TIMEOUT=30000
MAX_MCP_OUTPUT_TOKENS=8000

# Telemetry
CLAUDE_CODE_ENABLE_TELEMETRY=true
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_LOGS_EXPORT_INTERVAL=5000
